{
  "name": "smard-mcp",
  "version": "1.0.0",
  "description": "MCP server for German electricity market data from SMARD (Bundesnetzagentur)",
  "mcpName": "io.github.akquisio-dev/smard-mcp",
  "license": "MIT",
  "author": "akquisio-dev",
  "homepage": "https://github.com/akquisio-dev/smard-mcp#readme",
  "bugs": {
    "url": "https://github.com/akquisio-dev/smard-mcp/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akquisio-dev/smard-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "smard",
    "electricity",
    "energy",
    "germany"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "smard-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "!dist/smoke.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "smoke": "tsc -p tsconfig.build.json && node dist/smoke.js",
    "deploy": "bash deploy/deploy.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
